{
	"name": "diary",
	"version": "0.0.1",
	"private": true,
	"description": "Frontend build dependencies for the Diary project.",
	"scripts": {
		"build": "webpack --env server=${DIARY_API_SERVER:-http://localhost:9001}",
		"start": "webpack serve --env server=http://localhost:9001 --no-hot --no-bonjour",
		"build:cordova": "DIARY_API_SERVER=${DIARY_API_SERVER:-https://diary.cafe} npm run build -- --mode production && mkdir -p www && cp -R dist/. www/",
		"cordova:prepare": "npm run build:cordova && cordova prepare",
		"cordova:ios": "npm run cordova:prepare && cordova run ios",
		"cordova:android": "npm run cordova:prepare && cordova run android"
	},
	"dependencies": {
		"@babel/runtime": "^7.24.0",
		"core-js": "^3.40.0",
		"jsencrypt": "^3.5.4"
	},
	"devDependencies": {
		"@babel/core": "^7.24.0",
		"@babel/plugin-transform-runtime": "^7.24.0",
		"@babel/preset-env": "^7.24.0",
		"babel-loader": "^9.1.3",
		"cordova": "^12.0.0",
		"cordova-android": "^15.1.0",
		"cordova-ios": "^8.1.1",
		"diary-apns-registration": "file:cordova-plugins/apns-registration",
		"express": "^4.18.3",
		"webpack": "^5.88.2",
		"webpack-cli": "^5.1.4",
		"webpack-dev-server": "^4.15.2"
	},
	"cordova": {
		"platforms": [
			"ios",
			"android"
		],
		"plugins": {
			"com.jq.diary.apns-registration": {}
		}
	}
}